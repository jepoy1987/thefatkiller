{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@tfk/types": ["packages/types/src/index.ts"],
      "@tfk/validation": ["packages/validation/src/index.ts"],
      "@tfk/config": ["packages/config/src/index.ts"],
      "@tfk/auth": ["packages/auth/src/index.ts"],
      "@tfk/api": ["packages/api/src/index.ts"],
      "@tfk/scoring": ["packages/scoring/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
